{
  "version": 2,
  "builds": [
    {
      "src": "pages/api/tokens.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/tokens",
      "dest": "pages/api/tokens.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/$1"
    }
  ]
}